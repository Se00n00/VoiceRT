benchmarks/results/*.json

# editors / OS
.DS_Store
*.swp
*.swo
.vscode/
.idea/

# generated roll-up (keep local only)
COMPLETE.md

# local operator notes (keep local only)
AGENTS.md

# test suites run locally, not versioned
tests/

# voice-agent JSON session memory (runtime state, per docs/architecture.md)
sessions/

# secrets (API keys etc. — never commit)
.env
.env.*

# local per-session conversation dotfiles (<store_dir>, default .voicert/)
.voicert/

# node app build outputs (rebuild with npm install && npm run build)
tui-ink/node_modules/
tui-ink/dist/
tui-preview/node_modules/